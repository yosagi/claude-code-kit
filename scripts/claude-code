#!/bin/bash
# claude-code launcher with osc-tap logging
#
# osc-tap 経由で claude を起動し、OSC シーケンスをキャプチャする。
# セッションログのエクスポートやタイトル取得に利用される。
# osc-tap が PATH に無い場合は素の claude を直接起動する。
#
# 起動時に ~/Notes/claude-registry/dist/.dist-stamp が更新されていたら
# setup_global.sh --install を自動実行する（auto-install）。
# auto-install で wrapper 自身が更新された場合は起動せず終了する（要再起動）。
#
# CLAUDE.md / CLAUDE.local.md がなければ dist から自動配置、
# 更新があれば対話的に確認する。.no-claude-md-sync を置くと同期しない。
#
# cwd に .claude/ と reports/ が揃っていない場所での対話起動時は、
# 意図しないプロジェクト発生を防ぐため確認プロンプトを出す（上位は辿らない）。
# 新規プロジェクトとして続行する場合は、セッションログエクスポートの
# opt-in フラグ (.claude/export_session) を作成するかどうかも確認する。
#
# 起動時に reports/project_title.txt があれば表示する。
# ログ出力先: ~/.claude/osc-logs/
#
# Wrapper options:
#   --list-versions            インストール済み Claude Code バージョン一覧
#   --enforce-version VERSION  指定バージョンで起動（回帰回避用）
#   --no-osc-tap               osc-tap をバイパスして素の claude を起動
#   --show-context             動的コンテキストを表示して終了（claude は起動しない）
#   --no-context               動的コンテキスト組み立てをスキップ
#   --help                     wrapper ヘルプ + claude --help
#
# stdout が TTY でないときは osc-tap を自動バイパスする（systemd service など）。

VERSIONS_DIR="${HOME}/.local/share/claude/versions"
CLAUDE_SYMLINK="${HOME}/.local/bin/claude"
LOG_DIR="${HOME}/.claude/osc-logs"

# Versions to avoid on default launch. If the active version (as pointed to by
# the claude symlink) appears here, the wrapper falls back to the highest
# non-blacklisted version installed. --enforce-version bypasses this check.
VERSION_BLACKLIST=(
    "2.1.117"
)

print_wrapper_help() {
    cat <<'EOF'
claude-code wrapper (osc-tap logging + version management)

Wrapper-specific options:
  --list-versions            List installed Claude Code versions
  --enforce-version VERSION  Launch a specific version (e.g. 2.1.116)
                             Useful to pin around a buggy release.
  --no-osc-tap               Bypass osc-tap and exec claude directly.
                             Auto-enabled when stdout is not a TTY
                             (e.g. systemd service, CI, piped output).
  --show-context             Show dynamically assembled global KB context
                             and exit (does not launch claude).
  --no-context               Skip dynamic context assembly.

Versions listed in VERSION_BLACKLIST (near the top of this script) are
auto-avoided on default launch: the highest non-blacklisted version is
used instead. --enforce-version bypasses the blacklist.

Auto-install: if ~/Notes/claude-registry/dist/.dist-stamp differs from
~/.claude/.dist-stamp, setup_global.sh --install runs automatically
before launching claude. The same applies to each distribution route
under ~/Notes/claude-registry/dist-extras/<route>/ (.extras-stamp vs
~/.claude/extras-stamps/<route>).
Output is logged to ~/.claude/auto-install.log.
If the wrapper itself is updated by the install, it exits without
launching claude — run claude-code again to use the new wrapper.

Project directory guard: when launched interactively in a directory that
does not have both .claude/ and reports/ (cwd only, no parent traversal),
a confirmation prompt is shown before launching, to prevent accidentally
creating an unintended project. Skipped in non-interactive contexts
(headless, systemd, piped output).

Other options are passed through to claude.
Below is the underlying `claude --help` output:

---
EOF
}

is_blacklisted() {
    local v="$1"
    local b
    for b in "${VERSION_BLACKLIST[@]}"; do
        [[ "$v" == "$b" ]] && return 0
    done
    return 1
}

pick_fallback_version() {
    # Highest non-blacklisted installed version (empty if none).
    local candidates=()
    local v name
    for v in "$VERSIONS_DIR"/*; do
        [[ -x "$v" ]] || continue
        name="$(basename "$v")"
        is_blacklisted "$name" && continue
        candidates+=("$name")
    done
    (( ${#candidates[@]} == 0 )) && return 0
    printf '%s\n' "${candidates[@]}" | sort -V | tail -1
}

list_versions() {
    local current_target=""
    if [[ -L "$CLAUDE_SYMLINK" ]]; then
        current_target="$(readlink -f "$CLAUDE_SYMLINK" 2>/dev/null)"
    fi
    echo "Installed versions (in $VERSIONS_DIR):"
    local found=0
    for v in "$VERSIONS_DIR"/*; do
        [[ -x "$v" ]] || continue
        found=1
        local name markers
        name="$(basename "$v")"
        markers=""
        [[ "$v" == "$current_target" ]] && markers="current"
        if is_blacklisted "$name"; then
            markers="${markers:+$markers, }blacklisted"
        fi
        if [[ -n "$markers" ]]; then
            printf "  %s  (%s)\n" "$name" "$markers"
        else
            printf "  %s\n" "$name"
        fi
    done
    if (( ! found )); then
        echo "  (none)"
    fi
}

# Parse wrapper-specific flags (preserve order of passthrough args)
enforced_version=""
show_list=0
show_help=0
no_osc_tap=0
show_context=0
no_context=0
passthrough_args=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --list-versions)
            show_list=1
            shift
            ;;
        --enforce-version)
            if [[ $# -lt 2 ]]; then
                echo "claude-code: --enforce-version requires a value" >&2
                exit 2
            fi
            enforced_version="$2"
            shift 2
            ;;
        --enforce-version=*)
            enforced_version="${1#--enforce-version=}"
            shift
            ;;
        --no-osc-tap)
            no_osc_tap=1
            shift
            ;;
        --show-context)
            show_context=1
            shift
            ;;
        --no-context)
            no_context=1
            shift
            ;;
        --help|-h)
            show_help=1
            passthrough_args+=("$1")
            shift
            ;;
        *)
            passthrough_args+=("$1")
            shift
            ;;
    esac
done

# Auto-bypass osc-tap when stdout is not a TTY (headless / piped).
if [[ ! -t 1 ]]; then
    no_osc_tap=1
fi

# Auto-install: if registry dist (or any dist-extras route) has a newer stamp,
# run setup_global.sh --install.
REGISTRY_DIST="$HOME/Notes/claude-registry/dist"
REGISTRY_STAMP="$REGISTRY_DIST/.dist-stamp"
LOCAL_STAMP="$HOME/.claude/.dist-stamp"
EXTRAS_DIR="$HOME/Notes/claude-registry/dist-extras"
EXTRAS_STAMP_DIR="$HOME/.claude/extras-stamps"

# dist-extras の各経路の stamp を照合する。
# 1つでも差分があれば 0 を返す（extras 側のローカル stamp は setup_global.sh が更新する）。
extras_need_install() {
    [[ -d "$EXTRAS_DIR" ]] || return 1
    local route_dir route registry_stamp local_stamp
    for route_dir in "$EXTRAS_DIR"/*/; do
        [[ -f "$route_dir/.extras-stamp" ]] || continue
        route="$(basename "$route_dir")"
        registry_stamp="$(cat "$route_dir/.extras-stamp" 2>/dev/null)"
        local_stamp="$(cat "$EXTRAS_STAMP_DIR/$route" 2>/dev/null)"
        if [[ "$registry_stamp" != "$local_stamp" ]]; then
            return 0
        fi
    done
    return 1
}

maybe_auto_install() {
    local registry_stamp local_stamp dist_changed=0
    if [[ -f "$REGISTRY_STAMP" ]]; then
        registry_stamp="$(cat "$REGISTRY_STAMP" 2>/dev/null)" || registry_stamp=""
        local_stamp="$(cat "$LOCAL_STAMP" 2>/dev/null)"
        if [[ -n "$registry_stamp" && "$registry_stamp" != "$local_stamp" ]]; then
            dist_changed=1
        fi
    fi

    if (( ! dist_changed )) && ! extras_need_install; then
        return 0
    fi

    # extras だけの更新でもインストールはキット側のスクリプトが担う
    [[ -x "$REGISTRY_DIST/setup_global.sh" ]] || return 0

    # wrapper 自身が更新されるかを事前に判定しておく
    # （setup_global.sh は atomic (mv) で置き換えるため実行中の bash は壊れないが、
    #   新しい wrapper のロジックはこのプロセスには反映されないので再起動を促す）
    local wrapper_will_update=0
    if [[ -f "$REGISTRY_DIST/scripts/claude-code" ]] && \
       ! diff -q "$REGISTRY_DIST/scripts/claude-code" "$HOME/.local/bin/claude-code" >/dev/null 2>&1; then
        wrapper_will_update=1
    fi

    local log_file="$HOME/.claude/auto-install.log"
    echo "claude-code: dist updated, auto-installing..." >&2
    if "$REGISTRY_DIST/setup_global.sh" --install > "$log_file" 2>&1; then
        if [[ -f "$REGISTRY_STAMP" ]]; then
            mkdir -p "$(dirname "$LOCAL_STAMP")"
            cp "$REGISTRY_STAMP" "$LOCAL_STAMP"
        fi
        echo "claude-code: auto-install complete (log: $log_file)" >&2
        if (( wrapper_will_update )); then
            echo "claude-code: wrapper 自身が更新されました。再度 claude-code を起動してください" >&2
            exit 0
        fi
    else
        echo "claude-code: auto-install failed (log: $log_file)" >&2
    fi
}
maybe_auto_install

# Resolve project root by finding .claude/ directory (up to 5 levels up).
# git rev-parse --show-toplevel は使わない（git root ≠ project root の場合がある）。
resolve_project_root() {
    local dir="$(pwd)"
    local i
    for i in 1 2 3 4 5; do
        [[ -d "$dir/.claude" ]] && echo "$dir" && return 0
        local parent="$(dirname "$dir")"
        [[ "$parent" == "$dir" ]] && break
        dir="$parent"
    done
    pwd
}

# Project directory guard: cwd に .claude/ と reports/ が揃っていない場所での
# 起動は事故（意図しないプロジェクトの発生）の可能性が高いので確認する。
# 上位ディレクトリは辿らない（Claude Code 自体が settings / セッション履歴を
# cwd 基準で扱うため、サブディレクトリ起動も新規プロジェクト扱いになる）。
# CLAUDE.md 自動配置 (maybe_sync_claude_md) より前に呼ぶこと。
confirm_non_project_dir() {
    # 対話できない文脈ではスキップ（headless / systemd / パイプ実行）
    [[ -t 0 && -t 1 ]] || return 0
    [[ -r /dev/tty ]] || return 0

    [[ -d .claude && -d reports ]] && return 0

    local missing=()
    [[ -d .claude ]] || missing+=(".claude/")
    [[ -d reports ]] || missing+=("reports/")
    echo "claude-code: ここはプロジェクトディレクトリではないようです（${missing[*]} がありません）" >&2
    echo "  cwd: $(pwd)" >&2
    local answer
    read -p "新規プロジェクトとしてここで起動しますか? [y/N] " answer < /dev/tty
    if [[ ! "$answer" =~ ^[yY] ]]; then
        echo "claude-code: 起動を中止しました" >&2
        exit 1
    fi

    # セッションログエクスポート (session_end.sh) の opt-in フラグ
    if [[ ! -f .claude/export_session ]]; then
        read -p "セッションログのエクスポートを有効にしますか? (.claude/export_session を作成) [y/N] " answer < /dev/tty
        if [[ "$answer" =~ ^[yY] ]]; then
            mkdir -p .claude
            touch .claude/export_session
            echo "claude-code: .claude/export_session を作成しました" >&2
        fi
    fi
}

# CLAUDE.md / CLAUDE.local.md sync: deploy dist templates to project root.
NO_SYNC_MARKER=".no-claude-md-sync"

maybe_sync_claude_md() {
    [[ -d "$REGISTRY_DIST" ]] || return 0
    local project_root
    project_root="$(resolve_project_root)"
    [[ -f "$project_root/$NO_SYNC_MARKER" ]] && return 0

    local need_update=()
    for f in CLAUDE.md CLAUDE.local.md; do
        local src="$REGISTRY_DIST/$f"
        [[ -f "$src" ]] || continue
        if [[ ! -f "$project_root/$f" ]]; then
            cp "$src" "$project_root/$f"
            echo "claude-code: $f を配置しました" >&2
        elif ! diff -q "$src" "$project_root/$f" > /dev/null 2>&1; then
            need_update+=("$f")
        fi
    done

    if (( ${#need_update[@]} > 0 )); then
        echo "claude-code: ${need_update[*]} に更新があります" >&2
        read -p "更新しますか? [y/N] " answer < /dev/tty
        if [[ "$answer" =~ ^[yY] ]]; then
            for f in "${need_update[@]}"; do
                cp "$REGISTRY_DIST/$f" "$project_root/$f"
            done
            echo "claude-code: 更新しました" >&2
        fi
    fi
}
if (( ! show_help && ! show_list && ! show_context )); then
    confirm_non_project_dir
fi
maybe_sync_claude_md

# --list-versions: print and exit
if (( show_list )); then
    list_versions
    exit 0
fi

# Resolve which claude binary to use
claude_bin="claude"
if [[ -n "$enforced_version" ]]; then
    candidate="$VERSIONS_DIR/$enforced_version"
    if [[ ! -x "$candidate" ]]; then
        echo "claude-code: version '$enforced_version' not found in $VERSIONS_DIR" >&2
        echo "" >&2
        list_versions >&2
        exit 1
    fi
    claude_bin="$candidate"
elif (( ${#VERSION_BLACKLIST[@]} > 0 )) && [[ -L "$CLAUDE_SYMLINK" ]]; then
    current_target="$(readlink -f "$CLAUDE_SYMLINK" 2>/dev/null)"
    current_version="$(basename "$current_target")"
    if is_blacklisted "$current_version"; then
        fallback="$(pick_fallback_version)"
        if [[ -z "$fallback" ]]; then
            echo "claude-code: active version '$current_version' is blacklisted and no alternative is available in $VERSIONS_DIR" >&2
            echo "            override with --enforce-version $current_version" >&2
            exit 1
        fi
        echo "claude-code: active version '$current_version' is blacklisted; falling back to '$fallback'" >&2
        claude_bin="$VERSIONS_DIR/$fallback"
    fi
fi

# --help intercept: print wrapper help first, then delegate to claude --help
if (( show_help )); then
    print_wrapper_help
fi

# プロジェクトタイトルの表示（--help 時はスキップ）
if (( ! show_help )); then
    TITLE_FILE="reports/project_title.txt"
    if [[ -f "$TITLE_FILE" ]]; then
        printf '\033[36m%s\033[0m\n' "$(cat "$TITLE_FILE")"
    fi
fi

# Migration notice: global_rules.md → global KB
LEGACY_GLOBAL_RULES="$HOME/Notes/claude-registry/global_rules.md"
if [[ -f "$LEGACY_GLOBAL_RULES" ]]; then
    echo "claude-code: global_rules.md はグローバル KB に統合されました。" >&2
    echo "  削除してください: rm $LEGACY_GLOBAL_RULES" >&2
    echo "  ~/.claude/CLAUDE.md のインクルード行も不要です。" >&2
fi

# Dynamic context assembly: global KB → tmp/global_kb_context.md
BUILD_CONTEXT_SCRIPT="$HOME/.claude/scripts/build_startup_context.py"
CONTEXT_OUTPUT="tmp/global_kb_context.md"

maybe_build_context() {
    [[ -f "$BUILD_CONTEXT_SCRIPT" ]] || return 0
    local project_root
    project_root="$(resolve_project_root)"
    local output_path="$project_root/$CONTEXT_OUTPUT"
    mkdir -p "$(dirname "$output_path")"
    python3 "$BUILD_CONTEXT_SCRIPT" "$project_root" > "$output_path" 2>/dev/null
}

if (( show_context )); then
    if [[ -f "$BUILD_CONTEXT_SCRIPT" ]]; then
        project_root="$(resolve_project_root)"
        result=$(python3 "$BUILD_CONTEXT_SCRIPT" "$project_root" 2>/dev/null)
        if [[ -n "$result" ]]; then
            echo "$result"
            echo "---"
            echo "${#result} chars"
        else
            echo "(no matching global KB for this project)"
        fi
    else
        echo "build_startup_context.py not found: $BUILD_CONTEXT_SCRIPT" >&2
    fi
    exit 0
fi

if (( ! no_context && ! show_help )); then
    maybe_build_context
fi

if (( no_osc_tap )) || ! command -v osc-tap >/dev/null 2>&1; then
    # --no-osc-tap 指定時、非TTY環境、osc-tap が無い環境は素の claude を起動する。
    exec "$claude_bin" "${passthrough_args[@]}"
else
    exec osc-tap \
        --output "$LOG_DIR" \
        --matcher TITLE '0;(.*)' \
        --matcher TRANSCRIPT '10321;TRANSCRIPT=(.*)' \
        --matcher CWD '10321;CWD=(.*)' \
        --matcher SESSION_ID '10321;SESSION_ID=(.*)' \
        -- "$claude_bin" "${passthrough_args[@]}"
fi
